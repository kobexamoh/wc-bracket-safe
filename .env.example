# Environment variables - NEVER COMMIT .env FILE TO GIT
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values from Supabase dashboard
# 3. .env is in .gitignore (never pushed to repo)

# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Analytics ID (remove if not needed)
VITE_GA_ID=

# Environment
NODE_ENV=development

# --- Server-only (Vercel dashboard → Settings → Environment Variables) ---
# Never prefix these with VITE_ — they must NOT ship in the browser bundle.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_WEBHOOK_SECRET=generate-a-long-random-string
# RESEND_WEBHOOK_SECRET=whsec_...  (from Resend → Webhooks after you create one)
# NOTIFY_ALLOWED_ORIGINS=https://wc.kobexamoh.me,http://localhost:3000
#   Add your Vercel preview origin while testing, e.g.:
#   https://wc-bracket-safe-git-feature-login-registration-alerts-....vercel.app
